<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CI-only sanity check: compiles every HoloTable runtime and editor script against the public
    UnityEngine reference assemblies (NuGet) without a Unity install or licence.
    Third-party SDKs (AR Foundation, Vuforia, XR Hands, Input System, TextMeshPro) are
    replaced by minimal API stubs in ./Stubs, so this catches C# errors in our code,
    not SDK API drift. The real gate remains a Unity build.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0067;NU1701</NoWarn>
    <DefineConstants>$(DefineConstants);HOLO_ARFOUNDATION;HOLO_ARF6;HOLO_VUFORIA;HOLO_XR_HANDS;HOLO_INPUT_SYSTEM;UNITY_2021_3_OR_NEWER</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEditor">
      <HintPath>$(PkgUnity3D_SDK)/lib/UnityEditor.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Packages/com.adrimg.holotable/**/*.cs" Exclude="../../Packages/com.adrimg.holotable/Samples~/**" Link="Src/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="Stubs/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" />
    <!-- Only UnityEditor.dll is used (Editor/ scripts); its bundled UnityEngine.dll is excluded. -->
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

</Project>
