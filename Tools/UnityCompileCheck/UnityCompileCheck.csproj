<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CI-only sanity check: compiles every HoloTable runtime script against the public
    UnityEngine reference assemblies (NuGet) without a Unity install or licence.
    Third-party SDKs (AR Foundation, Vuforia, XR Hands, Input System, TextMeshPro) are
    replaced by minimal API stubs in ./Stubs, so this catches C# errors in our code,
    not SDK API drift. The real gate remains a Unity build.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0067;NU1701</NoWarn>
    <DefineConstants>$(DefineConstants);HOLO_ARFOUNDATION;HOLO_ARF6;HOLO_VUFORIA;HOLO_XR_HANDS;HOLO_INPUT_SYSTEM;UNITY_2021_3_OR_NEWER</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/_HoloTable/Scripts/**/*.cs" Link="Src/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="Stubs/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" />
  </ItemGroup>

</Project>
